{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Production Inference Serving Metrics (SLA & Health)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "Requests / Sec" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Real-time Inference Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"sentiment-api\"}[1m]))",
          "legendFormat": "Total Throughput (RPS)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisLabel": "Latency (Seconds)" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "Inference Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"sentiment-api\"}[2m])) by (le))",
          "legendFormat": "p50 Median"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"sentiment-api\"}[2m])) by (le))",
          "legendFormat": "p95 SLA Boundary (<= 100ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"sentiment-api\"}[2m])) by (le))",
          "legendFormat": "p99 Tail Latency"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Population Stability Index (PSI) Drift Level",
      "type": "gauge",
      "targets": [
        {
          "expr": "mlops_psi_drift_score",
          "legendFormat": "PSI Drift Score"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Infrastructure & Pod Health (Kubernetes HPA)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "title": "Active Replicas (HPA Auto-scaling 2 to 10)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{deployment=\"sentiment-api\"}",
          "legendFormat": "Available Replicas"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "title": "Pod CPU & Memory Utilization vs Limits",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"sentiment-api\"}[2m])) / sum(kube_pod_container_resource_limits{resource=\"cpu\", container=\"sentiment-api\"}) * 100",
          "legendFormat": "CPU Utilization (%)"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{container=\"sentiment-api\"}) / sum(kube_pod_container_resource_limits{resource=\"memory\", container=\"sentiment-api\"}) * 100",
          "legendFormat": "Memory Utilization (%)"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "production", "sentiment-api", "kubernetes", "prometheus"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "MLOps Sentiment Serving - Production Health & Drift",
  "uid": "mlops-sentiment-prod",
  "version": 1
}
